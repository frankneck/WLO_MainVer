<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIStyles/hud.uss?fileID=7433441132597879392&amp;guid=47e7c4e90fd52f14fbc2379fc228afaa&amp;type=3#hud"/>
    <Style src="project://database/Assets/UIStyles/base/theme.uss?fileID=7433441132597879392&amp;guid=6c4795b00b78dd0489e90145e24c5eb3&amp;type=3#theme"/>
    <ui:VisualElement name="Header" class="timer-section" style="top: 0; left: auto; justify-content: center; align-self: center;">
        <ui:VisualElement name="RedTeamScore" class="score red__score header__score-section" style="left: 10px; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; top: 25px; border-bottom-right-radius: 15px;">
            <ui:Label text="0" name="RedScore" class="score__text"/>
        </ui:VisualElement>
        <ui:VisualElement name="BlueTeamScore" class="score blue__score header__score-section" style="right: 10px; border-top-right-radius: 0; border-bottom-right-radius: 0; border-top-left-radius: 0; top: 25px; border-bottom-left-radius: 15px;">
            <ui:Label text="0&#10;" name="BlueScore" class="score__text"/>
        </ui:VisualElement>
        <ui:VisualElement name="MainSection" class="header__main-section" style="justify-content: space-around; height: 68px;">
            <ui:Label text="00:00" name="TimerText" class="round-timer__text" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;"/>
            <ui:Label text="0/0" name="PlayedRounds" class="played-rounds__text player__rounds played-rounds" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
