<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="PlayerListScreen" enabled="true" style="flex-grow: 1; width: 100%; height: 100%; align-items: center; align-content: center; justify-content: center; padding-top: 10%; padding-right: 10%; padding-bottom: 10%; padding-left: 10%; display: none; visibility: visible;">
        <ui:VisualElement name="PlayerList" style="flex-grow: 1; width: 60%; height: auto; background-color: rgba(26, 26, 26, 0.8); position: relative;">
            <ui:Label text="PLAYERS" style="font-size: 70%; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(255, 255, 255); border-top-width: 15px; border-right-width: 15px; border-bottom-width: 15px; border-left-width: 15px; border-left-color: rgba(0, 0, 0, 0.3); border-right-color: rgba(0, 0, 0, 0.3); border-top-color: rgba(0, 0, 0, 0.3); border-bottom-color: rgba(0, 0, 0, 0.3); margin: 0;"/>
            <ui:VisualElement style="flex-grow: 1; width: 100%; height: 5px; background-color: rgba(0, 0, 0, 0.5);"/>
            <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; flex-direction: row; background-color: rgba(0, 0, 0, 0);">
                <ui:VisualElement style="flex-grow: 1; width: 50%;">
                    <ui:Label text="RED TEAM" name="Label" style="margin: 0; padding: 0; color: rgb(255, 0, 0); font-size: 39%; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0.3);"/>
                    <ui:MultiColumnListView name="RedTeamPlayerListView" virtualization-method="DynamicHeight" focusable="false" selection-type="None" style="width: 100%; height: 100%; border-top-width: 15px; border-right-width: 15px; border-bottom-width: 15px; border-left-width: 15px; border-left-color: rgba(0, 0, 0, 0.3); border-right-color: rgba(0, 0, 0, 0.3); border-top-color: rgba(0, 0, 0, 0.3); border-bottom-color: rgba(0, 0, 0, 0.3); font-size: 50%;">
                        <ui:Columns>
                            <ui:Column name="player-name" title="NAME" width="65%"/>
                            <ui:Column min-width="35%" name="player-ping" title="PING"/>
                        </ui:Columns>
                    </ui:MultiColumnListView>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; width: 5px; height: 100%; background-color: rgba(0, 0, 0, 0.5);"/>
                <ui:VisualElement style="flex-grow: 1; width: 50%;">
                    <ui:Label text="BLUE TEAM" style="margin: 0; padding: 0; color: rgb(0, 88, 255); font-size: 39%; -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0.3);"/>
                    <ui:MultiColumnListView name="BlueTeamPlayerListView" virtualization-method="DynamicHeight" focusable="false" selection-type="None" style="width: 100%; height: 100%; border-top-width: 15px; border-right-width: 15px; border-bottom-width: 15px; border-left-width: 15px; border-left-color: rgba(0, 0, 0, 0.3); border-right-color: rgba(0, 0, 0, 0.3); border-top-color: rgba(0, 0, 0, 0.3); border-bottom-color: rgba(0, 0, 0, 0.3); font-size: 50%;">
                        <ui:Columns>
                            <ui:Column name="player-name" title="NAME" width="65%"/>
                            <ui:Column name="player-ping" title="PING" width="35%"/>
                        </ui:Columns>
                    </ui:MultiColumnListView>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="AppMenuScreen" style="flex-grow: 1; position: absolute; width: 100%; height: 100%;">
        <ui:VisualElement style="flex-grow: 1; width: 50%; height: 90%; position: absolute; bottom: auto; left: auto; top: auto; justify-content: center; align-content: center;">
            <ui:VisualElement style="flex-grow: 1; width: 60%; height: 50%; position: absolute; justify-content: center;">
                <ui:Button text="Disconnect" name="disconnectButton" style="background-color: rgba(0, 0, 0, 0.7); color: rgb(255, 255, 255); font-size: 30%; margin-top: 10px; padding: 10px;"/>
                <ui:Button text="Close HOST" name="closeHostButton" style="background-color: rgba(0, 0, 0, 0.7); color: rgb(255, 255, 255); font-size: 30%; margin-top: 10px; padding: 10px;"/>
                <ui:Button text="Quit" name="appQuitButton" style="background-color: rgba(0, 0, 0, 0.7); color: rgb(255, 255, 255); font-size: 30%; margin-top: 10px; padding: 10px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="AppStats" style="flex-grow: 1; right: 2%; top: 4%; width: 600px; height: 4%; position: absolute; flex-direction: row-reverse; opacity: 0.75;">
        <ui:Label text="- FPS" name="FPS" style="color: rgb(255, 255, 255); font-size: 30%; -unity-text-align: middle-right;"/>
        <ui:Label text="- PING" name="ping" style="color: rgb(255, 255, 255); font-size: 30%; -unity-text-align: middle-right;"/>
        <ui:Label text="- LOSS" name="loss" style="color: rgb(255, 255, 255); font-size: 30%; -unity-text-align: middle-right;"/>
    </ui:VisualElement>
</ui:UXML>