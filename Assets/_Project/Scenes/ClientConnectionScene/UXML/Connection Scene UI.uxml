<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; transition-property: all;">
        <ui:VisualElement name="MainMenu" style="flex-grow: 1; width: auto; height: 100%; justify-content: space-between; align-items: center; align-self: center; background-color: rgb(226, 226, 226); position: relative; bottom: 0; top: initial; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; min-width: 35%; max-width: 80%; min-height: auto; max-height: none; left: auto; align-content: center; visibility: visible; overflow: visible; display: flex; flex-direction: column; flex-wrap: nowrap; right: 0;">
            <ui:Label text="START GAME / CONNECT" style="left: auto; font-size: 48%; -unity-font-style: bold; margin-top: 0; margin-right: 0; margin-bottom: 5px; margin-left: 0;"/>
            <ui:VisualElement name="ConnectionProperties" style="flex-grow: 1; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; background-color: rgb(204, 204, 204); width: 100%;">
                <ui:TextField label="NICKNAME" placeholder-text="Nickname for game" value="Player" password="false" name="nickname" max-length="18" style="margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; font-size: 50%; -unity-font-style: bold; -unity-text-align: middle-left;"/>
                <ui:DropdownField label="MODE" choices="HOST,CLIENT" index="0" name="Mode" style="-unity-text-align: middle-left; -unity-font-style: bold; font-size: 50%; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;"/>
                <ui:TextField label="IP" placeholder-text="IP Connection" value="127.0.0.1" password="false" name="IP" style="margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; font-size: 50%; -unity-font-style: bold; -unity-text-align: middle-left;"/>
                <ui:IntegerField label="PORT" value="7979" max-length="5" password="false" placeholder-text="Connection Port" is-delayed="false" emoji-fallback-support="false" keyboard-type="Default" auto-correction="false" name="Port" style="margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; font-size: 50%; -unity-font-style: bold; -unity-text-align: middle-left;"/>
                <ui:DropdownField label="TEAM" choices="AUTO,BLUE,RED,SPECTATOR" index="0" name="Team" style="-unity-text-align: middle-left; -unity-font-style: bold; font-size: 50%; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;"/>
            </ui:VisualElement>
            <ui:Button text="START" name="Start" style="margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 0; height: auto; width: 100%; background-color: rgb(255, 255, 255); -unity-font-style: bold; font-size: 36%;"/>
            <ui:Button text="Exit" name="Exit" style="position: absolute; top: 36px; left: 1496px; height: 96px; width: 201px; font-size: 63px; color: rgb(14, 13, 13); background-color: rgb(142, 56, 56); -unity-background-image-tint-color: rgb(0, 0, 0); background-size: 100% 100%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
