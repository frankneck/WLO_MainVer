<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Screen" style="flex-grow: 1; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.4); display: none;">
        <ui:VisualElement name="Window" style="flex-grow: 1; position: absolute; top: 50%; width: 50%; height: 50%; left: 50%; transform-origin: center; translate: -50% -50%; background-color: rgb(166, 166, 166); border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-left-color: rgb(51, 51, 51); border-right-color: rgb(51, 51, 51); border-top-color: rgb(51, 51, 51); border-bottom-color: rgb(51, 51, 51); padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px; align-content: auto; justify-content: space-between;">
            <ui:Label name="ModalLabel" text="Label" style="margin-top: 0; margin-right: 0; margin-bottom: 10px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 100%; font-size: 45%; -unity-text-align: middle-left; white-space: pre-wrap;"/>
            <ui:ScrollView style="height: 100%; width: 100%; background-color: rgba(0, 0, 0, 0.1); padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                <ui:Label text="Label" name="Message" style="width: 100%; height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 32%;"/>
            </ui:ScrollView>
            <ui:Button text="CLOSE" name="CloseButton" style="bottom: 0%; position: relative; margin-top: 10px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px; width: 100%; height: auto; font-size: 32%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
