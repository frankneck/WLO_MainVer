:root{
    --friend-healthbar-color: rgb(99, 223, 69);
    --enemy-healthbar-color: rgb(237, 93, 67);
}

.friend-team__name {
    color: var(--friend-healthbar-color);
}

.friend-team__fill {
    background-color: var(--friend-healthbar-color);
}

.enemy-team__name {
    color: var(--enemy-healthbar-color);
}

.enemy-team__fill {
    background-color: var(--enemy-healthbar-color);
}

.world-health-bar__container {
    position: absolute;
    width: 400px;
    height: 90px;
    align-items: flex-start;
    flex-grow: 0;
    aspect-ratio: auto;
    translate: 0 0;
    top: auto;
    left: auto;
    display: flex;
}

.container__scale-container {
    width: auto;
    height: auto;
    flex-grow: 1;
}

.playerName {
    align-items: flex-start;
    -unity-font-style: bold;
    justify-content: flex-start;
    align-self: center;
    flex-grow: 0;
    width: 100%;
    height: 100%;
    font-size: 43px;
    -unity-text-align: middle-left;
}

.scale-container__root {
    width: 100%;
    height: 100%;
    border-top-width: 7px;
    border-right-width: 7px;
    border-bottom-width: 7px;
    border-left-width: 7px;
    border-top-color: var(--first-color);
    border-right-color: var(--first-color);
    border-bottom-color: var(--first-color);
    border-left-color: var(--first-color);
    flex-grow: 1;
}

.root__background {
    background-color: var(--second-color);
    width: 100%;
    height: 100%;
    color: var(--second-color);
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
}

.background__fill {
    height: 100%;
    width: 100%;
}
