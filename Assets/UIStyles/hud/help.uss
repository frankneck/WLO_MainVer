:root {
}

.help-section {
    bottom: 50px;
    position: absolute;
    right: 40px;
}

.help-section__open-inventory {
    flex-direction: row;
    align-items: center;
}

.open-inventory-help-button {
    width: 35px;
    height: 35px;
    background-color: var(--second-color);
    border-top-color: var(--first-color);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-right-color: var(--first-color);
    border-bottom-color: var(--first-color);
    border-left-color: var(--first-color);
}

.help-text {
    font-size: 26px;
    color: var(--first-color);
    -unity-text-align: middle-center;
    width: 100%;
    height: 100%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.description-text {
    color: var(--first-color);
    font-size: 20px;
}
