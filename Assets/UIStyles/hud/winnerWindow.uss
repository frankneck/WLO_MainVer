:root {
}

.winnder-window-container {
    background-color: var(--second-color);
    width: 670px;
    height: 145px;
    border-top-color: var(--first-color);
    border-right-color: var(--first-color);
    border-bottom-color: var(--first-color);
    border-left-color: var(--first-color);
    border-top-width: 9px;
    border-right-width: 9px;
    border-bottom-width: 9px;
    border-left-width: 9px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
}

.winner-windowcontainer__content-section {
    flex-direction: row;
    width: 100%;
    height: 100%;
}

.content-section__winner-text {
    width: auto;
    height: auto;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-text-align: middle-left;
    font-size: 40px;
    color: var(--first-color);
}

.red-winner__text {
    color: var(--red-team-color);
}

.blue-winner__text {
    color: var(--blue-team-color);
}

.winner-text {
    width: 48%;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 36px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}
