.game-menu-container {
    align-self: center;
    align-items: center;
    flex-direction: column;
    flex-grow: 0;
    justify-content: center;
    align-content: center;
    width: 100%;
    height: 100%;
}

.game-menu-container__game-menu-window {
    background-color: var(--first-color);
    width: 675px;
    height: 988px;
    align-self: center;
    justify-content: flex-start;
    align-items: flex-start;
    align-content: center;
}

.game-menu-window__content {
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
    border-left-color: var(--color-button-border);
    border-right-color: var(--color-button-border);
    border-top-color: var(--color-button-border);
    border-bottom-color: var(--color-button-border);
    background-color: var(--color-button-border);
    height: auto;
    width: 500px;
    align-items: center;
    justify-content: flex-start;
    align-self: center;
    flex-grow: 1;
}
