.section {
    width: 100%;
    margin-top: 49px;
}

.scroll-view {
    color: var(--first-color);
    background-color: var(--second-color);
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-top-color: var(--third-color);
    border-right-color: var(--third-color);
    border-bottom-color: var(--third-color);
    border-left-color: var(--third-color);
    width: 100%;
}

.popup__container {
    width: 100%;
    height: 100%;
    align-items: center;
    align-self: center;
    justify-content: center;
}

.window {
    width: 675px;
    min-width: auto;
    height: 988px;
    max-height: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    background-color: var(--first-color);
    border-radius: 5px;
    align-content: center;
    min-height: auto;
    flex-grow: 0;
    -unity-text-align: upper-left;
    align-self: center;
}

.window__content {
    width: 100%;
    height: 100%;
    flex-grow: 0;
    margin: 2% auto;
    background-color: var(--color-window-content);
    margin-right: 0;
    margin-left: 0;
    align-items: center;
    max-height: none;
    min-height: auto;
    max-width: none;
    align-content: auto;
    margin-top: 0;
    margin-bottom: 0;
    align-self: center;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-color: var(--third-color);
    border-right-color: var(--third-color);
    border-bottom-color: var(--third-color);
    border-left-color: var(--third-color);
}

.content__main {
    width: auto;
    height: auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    max-height: none;
    flex-grow: 0;
    min-height: auto;
    min-width: auto;
    align-content: center;
    align-self: flex-end;
}

.section {
    padding-bottom: 30px;
}

.section-row {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: auto;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    align-self: flex-start;
    align-content: flex-start;
    flex-grow: 1;
    width: auto;
}

.section-column {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    flex-wrap: nowrap;
    align-self: stretch;
    align-content: stretch;
}

.main__button-section {
    flex-grow: 0;
    max-height: none;
    flex-direction: row;
    align-content: stretch;
    align-items: center;
    width: 100%;
    height: auto;
}
