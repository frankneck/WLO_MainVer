:root {
    --color-slot-bg: rgba(170, 220, 235, 0.18);
    --color-slot-border: rgba(160, 220, 235, 0.35);
    --color-weapon-bg: rgba(170, 220, 235, 0.15);
    --color-weapon-border: rgba(170, 220, 235, 0.35);
    --color-stack: rgb(210, 235, 240);
    --color-header-bg: rgba(36, 78, 108, 0.95);
    --color-text: rgb(220, 235, 240);
    --color-bg-inventory: rgba(36, 78, 108, 0.85);
    --color-border: rgba(155, 214, 230, 0.35);
}

.inventory-container {
    width: 100%;
    height: 100%;
}

.container__window {
    right: 646px;
    top: 275px;
}

.inventoryHeader {
    justify-content: center;
    align-items: center;
    height: 100px;
}

.inventoryHeader Label {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
    font-size: 48px;
    color: var(--color-text);
}

.weaponSlots {
    flex-direction: row;
    align-self: center;
    align-items: flex-start;
    justify-content: flex-start;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    flex-wrap: wrap;
}

.window__inventory-frame {
    width: 300px;
    min-width: 285px;
    flex-direction: column;
    justify-content: flex-start;
    flex-grow: 0;
    height: auto;
    position: absolute;
    right: 0;
    left: 433px;
}

.inventory-frame__window {
    background-color: var(--first-color);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-color: var(--third-color);
    border-right-color: var(--third-color);
    border-bottom-color: var(--third-color);
    border-left-color: var(--third-color);
    margin-bottom: 0;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    right: 0;
    padding-top: 8px;
    position: relative;
    width: 300px;
}

.window__weapon-frame {
    margin-right: 8px;
    position: relative;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    height: 539px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-left-color: rgba(255, 255, 255, 0);
    border-right-color: rgba(255, 255, 255, 0);
    border-top-color: rgba(255, 255, 255, 0);
    border-bottom-color: rgba(255, 255, 255, 0);
    width: 445px;
}

.inventory-frame__equipment {
    background-color: var(--first-color);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-color: var(--third-color);
    border-right-color: var(--third-color);
    border-bottom-color: var(--third-color);
    border-left-color: var(--third-color);
    margin-bottom: 0;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
    top: auto;
    position: absolute;
    bottom: 356px;
    right: 550px;
    width: 308px;
    flex-direction: column;
}

.inventory-frame__backpack {
    background-color: var(--first-color);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-color: var(--third-color);
    border-right-color: var(--third-color);
    border-bottom-color: var(--third-color);
    border-left-color: var(--third-color);
    margin-top: 9px;
    bottom: 0;
    top: 0;
    height: auto;
}

.itemIcon {
    width: 90px;
    height: 90px;
    background-color: rgba(255, 255, 255, 0);
}

.slotsContainer {
    flex-direction: row;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    align-items: center;
    justify-content: flex-start;
    align-self: center;
    align-content: center;
    flex-grow: 0;
}

.equipmentSlots {
    flex-direction: row;
    margin-bottom: 0;
    padding: 6px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--color-weapon-border);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-left: 0;
}

.inventorySlots {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-self: center;
    align-content: center;
    align-items: center;
}

.slot {
    width: 60px;
    height: 60px;
    margin: 4px;
}

.slotFrame {
    position: absolute;
    width: 60px;
    height: 60px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--color-slot-border);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-color: var(--third-color);
    border-right-color: var(--third-color);
    border-bottom-color: var(--third-color);
    border-left-color: var(--third-color);
}

.slotIcon:hover {
    background-color: rgba(255, 255, 255, 0.1);
    transition: background-color 0.1s ease;
}

.slotIcon {
    padding: 4px;
    flex-grow: 1;
}

.stackCount {
    position: absolute;
    bottom: 2px;
    right: 4px;
    font-size: 16px;
    color: var(--first-color);
}

.ghostIcon {
    visibility: hidden;
    position: absolute;
    width: 60px;
    height: 60px;
    background-image: none;
}

.window__content {
    justify-content: space-around;
    align-items: center;
}

.information__paramter-section {
    border-top-color: var(--third-color);
    border-right-color: var(--third-color);
    border-bottom-color: var(--third-color);
    border-left-color: var(--third-color);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    align-self: center;
    justify-content: center;
    margin-left: 4px;
    margin-right: 4px;
}

.parameter-section__text {
    border-top-color: var(--third-color);
    color: var(--second-color);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 2px;
    padding-left: 6px;
    -unity-text-align: upper-left;
    font-size: 13px;
}

.parameter-section__divider {
    background-color: var(--second-color);
}

.window__information {
    padding: 6px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--color-weapon-border);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    flex-direction: row;
}
